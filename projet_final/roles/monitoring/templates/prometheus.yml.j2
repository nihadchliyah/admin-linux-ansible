# Configuration Prometheus - gere par Ansible (projet final)
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alertes.yml

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # Un exporter par serveur de l'inventaire
  - job_name: "serveurs"
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - "{{ host }}:9100"
{% endfor %}
